{
  "name": "yek",
  "version": "3.0.0",
  "description": "Generates a key path from arrays and back again.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run check && pnpm run build && pnpm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kahwee/yek.git"
  },
  "keywords": [
    "keypath",
    "notation",
    "bracket",
    "array"
  ],
  "author": "KahWee Teng <t@kw.sg> (http://kw.sg/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kahwee/yek/issues"
  },
  "homepage": "https://github.com/kahwee/yek",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
