{
  "name": "yek",
  "version": "3.0.0",
  "description": "Generates a key path from arrays and back again.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/migration-v3.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run check && pnpm run build && pnpm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kahwee/yek.git"
  },
  "keywords": [
    "keypath",
    "notation",
    "bracket",
    "array"
  ],
  "author": "KahWee Teng <t@kw.sg> (http://kw.sg/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kahwee/yek/issues"
  },
  "homepage": "https://github.com/kahwee/yek",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  }
}
